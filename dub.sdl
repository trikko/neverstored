name "neverstored"
description "Hand a secret to someone while you are both there. Nothing is ever stored."
authors "Andrea Fontana"
license "MIT"
targetType "executable"
mainSourceFile "source/app.d"
stringImportPaths "static"
dependency "serverino" version="~>0.8.1"

buildType "small" {
	buildOptions "releaseMode" "optimize"
	dflags "-Oz" "-L=--gc-sections" "-linker=lld" "-L=--icf=all" platform="ldc"
	dflags "-L--gc-sections" platform="dmd"
	postBuildCommands "test -f \"$DUB_TARGET_PATH/$DUB_TARGET_NAME\" && strip -s \"$DUB_TARGET_PATH/$DUB_TARGET_NAME\" || true" platform="posix"
}

# A binary that owes nothing to the image it runs in: musl, statically linked, so the
# runtime stage can be scratch. Kept apart from "small" so the deploy build never moves.
buildType "container" {
	buildOptions "releaseMode" "optimize"
	dflags "-Oz" "-static" "-linker=lld" "-L=--gc-sections" "-L=--icf=all" platform="ldc"
	postBuildCommands "test -f \"$DUB_TARGET_PATH/$DUB_TARGET_NAME\" && strip -s \"$DUB_TARGET_PATH/$DUB_TARGET_NAME\" || true" platform="posix"
}
